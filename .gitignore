# Dependencies
node_modules/

# Native projects — this app uses Continuous Native Generation (expo run:ios /
# expo run:android regenerate these on demand from app.json/app.config.js).
# Never commit them; they're build output, not source.
/ios
/android
ios/
android/

# Expo / Metro
.expo/
dist/
web-build/
.metro-health-check*

# WDK worklet bundle — generated by `wdk-worklet-bundler generate` (runs on
# every `npm install` via postinstall). Regenerated from wdk.config.js, never
# hand-edited, never committed.
.wdk-bundle/
.wdk/

# Secrets — never commit real values. .env.example (once it exists) is
# intentionally NOT matched by this pattern and should stay tracked.
.env
.env.local
.env.*.local

# Doctor-specific runtime config — personal per contributor, keyed to
# whatever package(s) they're actively testing. doctor.runtime.example.json
# (the checked-in template) is NOT matched by this and should stay tracked.
doctor.runtime.json

# Signing credentials — should never end up in git history regardless of
# platform or how they got generated locally.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
credentials.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# TypeScript incremental build info
*.tsbuildinfo

# OS cruft
.DS_Store
Thumbs.db

npm-debug.*
*.key
*.orig.*
*.bundle
*.bundle.js