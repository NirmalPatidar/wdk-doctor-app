# ── WDK Chain Providers ────────────────────────────────────────────────────────
# Refer to https://docs.wdk.tether.io/ for instructions on how to obtain these values.
# Bitcoin, Ethereum, and Tron below are all real testnets — this app is not
# configured for mainnet on any of them except Spark, which is a deliberate
# exception documented in doctor.runtime.json's own _readme field.

# Real, free, working public endpoint — not a placeholder, no signup needed.
EXPO_PUBLIC_BTC_PROVIDER=https://tbtc1.trezor.io/api

# Sepolia testnet (chain 11155111) — needs your own key from a provider like
# Alchemy or Infura's Sepolia endpoint, not a mainnet one.
EXPO_PUBLIC_EVM_PROVIDER=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
EXPO_PUBLIC_EVM_BUNDLER_URL=https://your-bundler.example.com
EXPO_PUBLIC_EVM_PAYMASTER_URL=https://your-paymaster.example.com

# Real, free, working public endpoint (Nile testnet) — not a placeholder.
EXPO_PUBLIC_TRON_PROVIDER=https://nile.trongrid.io/
# Nile testnet gasfree endpoint — needs your own key from gasfree.io's dev portal.
EXPO_PUBLIC_TRON_GASFREE_PROVIDER=https://open-test.gasfree.io/nile
EXPO_PUBLIC_TRON_GASFREE_API_KEY=your-api-key
EXPO_PUBLIC_TRON_GASFREE_API_SECRET=your-api-secret
